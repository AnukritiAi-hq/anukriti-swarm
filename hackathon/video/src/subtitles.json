  {
    "text": "PubMed PMID.",
    "startSec": 44.141,
    "endSec": 45.917
  },
  {
    "text": "PharmGKB accession.",
    "startSec": 46.068,
    "endSec": 47.856
  },
  {
    "text": "No hallucinations.",
    "startSec": 48.007,
    "endSec": 49.18
  },
  {
    "text": "No silent prescriptions.",
    "startSec": 49.296,
    "endSec": 50.793
