  {
    "text": "five specialist agents collaborate.",
    "startSec": 26.528,
    "endSec": 28.862
  },
  {
    "text": "Population reasoning.",
    "startSec": 29.141,
    "endSec": 30.441
  },
  {
    "text": "Phenotype inference.",
    "startSec": 30.615,
    "endSec": 31.997
  },
  {
    "text": "Knowledge graph traversal.",
    "startSec": 32.148,
    "endSec": 33.68
  },
  {
    "text": "Sufficiency governance.",
    "startSec": 33.796,
    "endSec": 35.097
  },
  {
    "text": "And deterministic verification.",
    "startSec": 35.213,
    "endSec": 37.314
  },
  {
    "text": "The response is a full FHIR bundle.",
    "startSec": 37.639,
    "endSec": 40.565
