[
  {
    "text": "Fourteen percent of South Asians cannot activate",
    "startSec": 0,
    "endSec": 2.984
  },
  {
    "text": "clopidogrel.",
    "startSec": 3.042,
    "endSec": 3.994
  },
  {
    "text": "Yet they are prescribed it at the",
    "startSec": 4.319,
    "endSec": 5.898
  },
  {
    "text": "same rate as Europeans,",
    "startSec": 5.956,
    "endSec": 7.477
  },
  {
    "text": "where only two percent are affected.",
    "startSec": 7.57,
    "endSec": 9.683
  },
  {
    "text": "Meet Anukriti PGx.",
    "startSec": 10.066,
    "endSec": 12.759
  },
  {
    "text": "A pharmacogenomic intelligence superpower.",
    "startSec": 12.968,
    "endSec": 15.523
  },
  {
    "text": "Built on MCP, SHARP,",
    "startSec": 15.732,
    "endSec": 17.96
  },
  {
    "text": "and FHIR.",
    "startSec": 18.076,
    "endSec": 19.679
  },
  {
    "text": "Watch the Consultant agent in action.",
    "startSec": 19.888,
    "endSec": 21.826
  },
  {
    "text": "We ask a real clinical question.",
    "startSec": 21.943,
    "endSec": 24.566
