  {
    "text": "Sparse population data.",
    "startSec": 63.123,
    "endSec": 64.644
  },
  {
    "text": "Hallucination detection.",
    "startSec": 64.818,
    "endSec": 66.246
  },
  {
    "text": "Six out of six pass.",
    "startSec": 66.525,
    "endSec": 67.976
  },
  {
    "text": "Autonomous delivery approved.",
    "startSec": 68.151,
    "endSec": 69.997
  },
  {
