  {
    "text": "Evidence grounding.",
    "startSec": 57.945,
    "endSec": 59.06
  },
  {
    "text": "Deterministic boundary.",
    "startSec": 59.385,
    "endSec": 60.534
  },
  {
    "text": "Provenance.",
    "startSec": 60.569,
    "endSec": 61.254
  },
  {
    "text": "Guideline conflicts.",
    "startSec": 61.428,
    "endSec": 62.914
