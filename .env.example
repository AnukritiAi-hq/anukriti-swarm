# Anukriti Swarm - Environment Configuration
# Copy this file to .env and fill in values

# LLM Provider (Gemini is primary — others for future multi-model support)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Vector Store
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_COLLECTION=anukriti_memory

# MCP Persistence (optional — all services fall back to in-memory)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
# MONGODB_DB=anukriti_swarm

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Research Mode
RESEARCH_ONLY=true
DETERMINISTIC_MODE=true
